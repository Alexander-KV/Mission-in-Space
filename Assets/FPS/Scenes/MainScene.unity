      m_Calls: []
  m_text: "Mission in space\n\r\n\u0412 \u0434\u0430\u043B\u0435\u043A\u043E\u0439
    \u0434\u0430\u043B\u0435\u043A\u043E\u0439 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0435
    ...\n\u0418\u043C\u043F\u0435\u0440\u0438\u044F \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u043D\u043E\u0432\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435
    \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442\u044C \u0446\u0435\u043B\u044B\u0435
    \u043F\u043B\u0430\u043D\u0435\u0442\u044B. \u0412\u044B \u044D\u043B\u0438\u0442\u043D\u044B\u0439
    \u043D\u0430\u0435\u043C\u043D\u0438\u043A \u043F\u043E\u0432\u0441\u0442\u0430\u043D\u0446\u0435\u0432
    \u0438 \u0432\u0430\u0448\u0430 \u043C\u0438\u0441\u0441\u0438\u044F - \u0443\u043A\u0440\u0430\u0441\u0442\u044C
    \u0447\u0435\u0440\u0442\u0435\u0436\u0438 \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
    \u0437\u0432\u0435\u0437\u0434\u043D\u044B\u0439 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C
    \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043E\u043D\u0438 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F.\n"
  m_isRightToLeft: 0
